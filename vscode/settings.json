{
  // appearance
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "workbench.colorTheme": "Light+",
  "workbench.iconTheme": "material-icon-theme",
  "editor.minimap.enabled": false,
  "workbench.tips.enabled": false,
  "breadcrumbs.enabled": false,
  "files.autoSave": "onFocusChange",
  "workbench.editor.showTabs": "multiple",
  "window.commandCenter": false,
  // if you opt for tabs :)
  "window.restoreWindows": "preserve",
  "files.hotExit": "onExit",
  "workbench.editor.restoreViewState": true,
  // vscodevim settings
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.useCtrlKeys": true,
  // vscodevim appearance settings
  "editor.cursorSurroundingLines": 10,
  "vim.smartRelativeLine": true,
  // highlighted yank
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(250, 189, 47, 0.5)",
  "vim.highlightedyank.textColor": "#202020",
  "vim.highlightedyank.duration": 150,
  // C# has no source.organizeImports code action; Roslyn only sorts usings during format
  "dotnet.formatting.organizeImportsOnFormat": true,
  // other settings
  "terminal.integrated.fontFamily": "monospace",
  "explorer.confirmDelete": false,
  "git.blame.statusBarItem.enabled": false,
  "workbench.preferredDarkColorTheme": "Monokai Dimmed",
  "window.autoDetectColorScheme": true,
  // statusbar colors
  "vim.statusBarColorControl": false,
  "vim.statusBarColors.normal": [
    "#171819",
    "#ffffff"
  ],
  "vim.statusBarColors.insert": [
    "#2C2E07",
    "#ffffff"
  ],
  "vim.statusBarColors.visual": [
    "#35151D",
    "#ffffff"
  ],
  "vim.statusBarColors.visualline": [
    "#35151D",
    "#ffffff"
  ],
  "vim.statusBarColors.visualblock": [
    "#35151D",
    "#ffffff"
  ],
  "vim.statusBarColors.commandlineinprogress": [
    "#2C2206",
    "#ffffff"
  ],
  "vim.statusBarColors.searchinprogressmode": [
    "#171819",
    "#ffffff"
  ],
  "vim.statusBarColors.surroundinputmode": [
    "#171819",
    "#ffffff"
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "g",
        "i"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "g",
        "y"
      ],
      "commands": [
        "editor.action.goToTypeDefinition"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "<A-j>"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ]
    },
    {
      "before": [
        "<A-k>"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ]
    }
  ],
  // which key settings
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "whichkey.show"
      ]
    },
    {
      "before": [
        "<Esc>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "x"
      ],
      "after": [
        "\"",
        "_",
        "x"
      ]
    },
    {
      "before": [
        "X"
      ],
      "after": [
        "\"",
        "_",
        "X"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "whichkey.show"
      ]
    },
    {
      "before": [
        "<"
      ],
      "after": [
        "<",
        "g",
        "v"
      ]
    },
    {
      "before": [
        ">"
      ],
      "after": [
        ">",
        "g",
        "v"
      ]
    },
    {
      "before": [
        "<A-j>"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ]
    },
    {
      "before": [
        "<A-k>"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ]
    }
  ],
  "whichkey.useFullWidthCharacters": true,
  "whichkey.bindingOverrides": [],
  "whichkey.bindings": [
    {
      "key": "/",
      "name": "[/] Fuzzy search in current editor",
      "type": "command",
      "command": "fuzzySearch.activeTextEditor",
    },
    {
      "key": "f",
      "name": "[F]ind/Search",
      "type": "bindings",
      "bindings": [
        {
          "key": "e",
          "name": "Find [E]verywhere",
          "type": "command",
          "command": "workbench.action.quickOpen",
        },
        {
          "key": "c",
          "name": "Find [C]lass",
          "type": "command",
          "command": "workbench.action.showAllSymbols",
        },
        {
          "key": "f",
          "name": "Find [F]ile",
          "type": "command",
          "command": "workbench.action.quickOpen",
        },
        {
          "key": "s",
          "name": "Find [S]ymbol",
          "type": "command",
          "command": "workbench.action.gotoSymbol",
        },
        {
          "key": "a",
          "name": "Find [A]ction",
          "type": "command",
          "command": "workbench.action.showCommands",
        },
        {
          "key": "t",
          "name": "Find [T]ext",
          "type": "command",
          "command": "workbench.action.findInFiles",
        },
        {
          "key": "p",
          "name": "Find in [P]ath",
          "type": "command",
          "command": "workbench.action.findInFiles",
        },
        {
          "key": ".",
          "name": "Recent Files",
          "type": "command",
          "command": "workbench.action.openRecent",
        },
      ],
    },
    {
      "key": "h",
      "name": "[H]arpoon",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "[A]dd editor to harpoon",
          "type": "command",
          "command": "vscode-harpoon.addEditor",
        },
        {
          "key": "e",
          "name": "[E]dit harpoon editors",
          "type": "command",
          "command": "vscode-harpoon.editEditors",
        },
        {
          "key": "s",
          "name": "[S]earch harpoon editors",
          "type": "command",
          "command": "vscode-harpoon.editorQuickPick",
        }
      ],
    },
    {
      "key": "s",
      "name": "[S]plits",
      "type": "bindings",
      "bindings": [
        {
          "key": "d",
          "name": "Split and move tab [D]own",
          "type": "command",
          "command": "workbench.action.moveEditorToBelowGroup"
        },
        {
          "key": "r",
          "name": "Split and move tab [R]ight",
          "type": "command",
          "command": "workbench.action.moveEditorToRightGroup"
        },
        {
          "key": "u",
          "name": "[U]nsplit all",
          "type": "command",
          "command": "workbench.action.joinAllGroups"
        }
      ]
    },
    // LSP
    {
      "key": "r",
      "name": "[R]efactoring",
      "type": "bindings",
      "bindings": [
        {
          "key": "r",
          "name": "[R]ename element",
          "type": "command",
          "command": "editor.action.rename"
        },
        {
          "key": "e",
          "name": "[E]xtract method",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "v",
          "name": "Introduce [V]ariable",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "f",
          "name": "Introduce [F]ield",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "c",
          "name": "[C]hange signature",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "l",
          "name": "Open refactorings [L]ist",
          "type": "command",
          "command": "editor.action.refactor"
        },
        {
          "key": "s",
          "name": "[S]urround with",
          "type": "command",
          "command": "editor.action.surroundWithSnippet"
        }
      ]
    },
    {
      "key": "w",
      "name": "Scratches ([W]ork files)",
      "type": "bindings",
      "bindings": [
        {
          "key": "b",
          "name": "New scratch [B]uffer",
          "type": "command",
          "command": "workbench.action.files.newUntitledFile"
        }
      ]
    },
    {
      "key": "t",
      "name": "[T]abs",
      "type": "bindings",
      "bindings": [
        {
          "key": "p",
          "name": "[P]in",
          "type": "command",
          "command": "workbench.action.pinEditor"
        },
        {
          "key": "c",
          "name": "[C]lose all but pinned",
          "type": "command",
          "command": "workbench.action.closeUnpinnedEditors"
        },
        {
          "key": "x",
          "name": "Close all",
          "type": "command",
          "command": "workbench.action.closeAllEditors"
        }
      ]
    },
    {
      "key": "n",
      "name": "[N]avigation",
      "type": "bindings",
      "bindings": [
        {
          "key": "c",
          "name": "[C]ommit",
          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "g",
          "name": "[G]it",
          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "t",
          "name": "[T]ests",
          "type": "command",
          "command": "testing.showMostRecentOutput"
        },
        {
          "key": "e",
          "name": "[E]xplorer",
          "type": "command",
          "command": "workbench.view.explorer"
        }
      ]
    },
    {
      "key": "j",
      "name": "[J]ump to X",
      "type": "bindings",
      "bindings": [
        {
          "key": "d",
          "name": "[D]efinition",
          "type": "command",
          "command": "editor.action.revealDefinition"
        },
        {
          "key": "t",
          "name": "[T]ype Definition",
          "type": "command",
          "command": "editor.action.goToTypeDefinition"
        },
        {
          "key": "i",
          "name": "[I]mplementation",
          "type": "command",
          "command": "editor.action.goToImplementation"
        },
        {
          "key": "b",
          "name": "[B]ase",
          "type": "command",
          "command": "editor.action.goToImplementation"
        },
        {
          "key": "u",
          "name": "[U]sages",
          "type": "command",
          "command": "editor.action.goToReferences"
        },
        {
          "key": "q",
          "name": "[Q]uick Implementation",
          "type": "command",
          "command": "editor.action.goToImplementation"
        }
      ]
    },
    {
      "key": "g",
      "name": "[G]it",
      "type": "bindings",
      "bindings": [
        {
          "key": "b",
          "name": "[B]ranches",
          "type": "command",
          "command": "git.checkout"
        },
        {
          "key": "a",
          "name": "[A]nnotate",
          "type": "command",
          "command": "git.blame.toggleEditorDecoration"
        }
      ]
    },
    {
      "key": "a",
      "name": "Project [A]ctions",
      "type": "bindings",
      "bindings": [
        {
          "key": "b",
          "name": "[B]uild",
          "type": "command",
          "command": "workbench.action.tasks.build"
        },
        {
          "key": "r",
          "name": "[R]un",
          "type": "command",
          "command": "workbench.action.debug.run"
        },
        {
          "key": "d",
          "name": "[D]ebug",
          "type": "command",
          "command": "workbench.action.debug.start"
        },
        {
          "key": "s",
          "name": "[S]top",
          "type": "command",
          "command": "workbench.action.debug.stop"
        }
      ]
    },
    {
      "key": "m",
      "name": "EF Core [M]igrations",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "[A]dd migration",
          "type": "command",
          "command": "workbench.action.tasks.runTask"
        }
      ]
    },
    {
      "key": "q",
      "name": "Testing",
      "type": "bindings",
      "bindings": [
        {
          "key": "r",
          "name": "[R]un test at cursor",
          "type": "command",
          "command": "testing.runAtCursor"
        },
        {
          "key": "d",
          "name": "[D]ebug test at cursor",
          "type": "command",
          "command": "testing.debugAtCursor"
        },
        {
          "key": "a",
          "name": "Run [A]ll tests in solution",
          "type": "command",
          "command": "testing.runAll"
        }
      ]
    },
    {
      "key": "b",
      "name": "[B]ookmarks",
      "type": "bindings",
      "bindings": [
        {
          "key": "t",
          "name": "[T]oggle bookmark",
          "type": "command",
          "command": "bookmarks.toggle"
        },
        {
          "key": "s",
          "name": "[S]how bookmarks",
          "type": "command",
          "command": "bookmarks.list"
        },
        {
          "key": "n",
          "name": "[N]ext bookmark",
          "type": "command",
          "command": "bookmarks.jumpToNext"
        },
        {
          "key": "p",
          "name": "[P]revious bookmark",
          "type": "command",
          "command": "bookmarks.jumpToPrevious"
        },
        {
          "key": "a",
          "name": "Toggle with mnemonic",
          "type": "command",
          "command": "bookmarks.toggle"
        }
      ]
    },
    {
      "key": "d",
      "name": "Go to [D]efinition",
      "type": "command",
      "command": "editor.action.revealDefinition"
    },
    {
      "key": "e",
      "name": "Go to impl[E]mentation",
      "type": "command",
      "command": "editor.action.goToImplementation"
    },
    {
      "key": "k",
      "name": "Hover info",
      "type": "command",
      "command": "editor.action.showHover"
    },
    {
      "key": "c",
      "name": "[C]omment line",
      "type": "command",
      "command": "editor.action.commentLine"
    },
    {
      "key": "o",
      "name": "[O]rganize imports",
      "type": "conditional",
      "bindings": [
        {
          // C# has no source.organizeImports provider; usings sort on format
          // via dotnet.formatting.organizeImportsOnFormat
          "key": "languageId:csharp",
          "name": "Sort usings (via format)",
          "type": "command",
          "command": "editor.action.formatDocument"
        },
        {
          // fallback for all other languages
          "key": "default",
          "name": "Organize imports",
          "type": "command",
          "command": "editor.action.codeAction",
          "args": {
            "kind": "source.organizeImports",
            "apply": "first"
          }
        }
      ]
    },
    {
      "key": "i",
      "name": "Auto [I]ndent",
      "type": "command",
      "command": "editor.action.reindentlines"
    },
    {
      "key": "p",
      "name": "Format code ([P]retty)",
      "type": "command",
      "command": "editor.action.formatDocument"
    },
    {
      "key": "8",
      "name": "Toggle Distraction Free Mode",
      "type": "command",
      "command": "workbench.action.toggleZenMode"
    },
    {
      "key": "l",
      "name": "Toggle sticky [L]ines",
      "type": "command",
      "command": "editor.action.toggleStickyScroll"
    }
  ],
  "editor.guides.indentation": false,
  "workbench.startupEditor": "welcomePageInEmptyWorkbench",
  "editor.fontSize": 14,
  "git.blame.editorDecoration.enabled": false,
  "workbench.colorCustomizations": {
    "statusBar.background": "#171819",
    "statusBar.noFolderBackground": "#171819",
    "statusBar.debuggingBackground": "#171819",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingForeground": "#ffffff"
  },
  "claudeCode.preferredLocation": "panel",
  "explorer.confirmDragAndDrop": false,
  "editor.formatOnSave": true,
  "chat.disableAIFeatures": true,
  "workbench.preferredLightColorTheme": "Light+",
}